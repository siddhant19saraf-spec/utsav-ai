# UTSAV AI — server environment template
#
# Copy this file to .env.local (ignored by Git) and fill in real values there.
# Never commit a real key. The application and its test suite run without these values;
# the AI Planner then reports that AI is not configured and offers the local outline.
#
# These variables are read only by the Node server (`npm run dev:api` or `npm start`).
# They are never compiled into the browser bundle. Do NOT rename them with a VITE_
# prefix: VITE_* values are public and end up in client code.
#
# The key stays server-side. Never paste it into browser code, screenshots, logs, or
# committed files. On a public deployment, anyone who can reach the app can call the
# AI endpoint, so use a restricted key and a provider-side spending limit.

# Required for AI suggestions. Paste your provider key only in .env.local.
# Leave blank to keep AI disabled: the app stays fully usable and the AI Planner
# reports that AI is not configured. Placeholders are intentionally empty.
AI_PROVIDER_API_KEY=

# Required for AI suggestions (for example: gpt-4o-mini or another model the provider
# exposes). No default is assumed because availability differs per provider.
# Leave blank to keep AI disabled.
AI_MODEL=

# Optional. Any OpenAI-compatible Chat Completions base URL.
AI_BASE_URL=https://api.openai.com/v1

# Optional safe display label shown in the UI.
AI_PROVIDER_NAME=OpenAI-compatible provider

# Optional server limits. Values outside the documented ranges are rejected or defaulted
# at startup.
# AI_REQUEST_TIMEOUT_MS=20000
# AI_MAX_OUTPUT_TOKENS=1800
# AI_RATE_LIMIT_MAX=10
# AI_RATE_LIMIT_WINDOW_MS=60000
# AI_MAX_REQUEST_BYTES=96000

# Local binding defaults to loopback. A hosting platform normally requires 0.0.0.0.
# AI_SERVER_HOST=127.0.0.1
# AI_SERVER_PORT=8787

# Production same-origin frontend serving. Leave disabled for API-only development.
# When enabled, the Node server serves the Vite build in STATIC_DIR and falls back to
# index.html for client-side routes. Run `npm run build` first.
# SERVE_STATIC=false
# STATIC_DIR=dist

# Hosting platforms usually inject PORT. It is used only when AI_SERVER_PORT is unset.
